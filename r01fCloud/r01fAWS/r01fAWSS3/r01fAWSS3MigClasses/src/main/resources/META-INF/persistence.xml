<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
	<!--
	============================================================
	DRIVERMANAGER DB CONNECTION
	============================================================
	-->
	<persistence-unit name="migrationS3" transaction-type="RESOURCE_LOCAL">
       	<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

		<!-- ENTITIES -->
		<class>r01f.cloud.aws.s3.migration.db.entities.R01TDBEntityForMigS3</class>
		<class>r01f.cloud.aws.s3.migration.db.entities.R01TDBEntityForMigS3Obj</class>

		<exclude-unlisted-classes>true</exclude-unlisted-classes>


		<!-- BBDD CONNECTION -->
		<!-- see appCode.persistence.xml -->

		<!-- Put any aditional property at r01t.publishengine.dbpersistence.properties.xml  -->
		<properties>
			<property name="eclipselink.tenant-id" value="default"/>
			<property name="jakarta.persistence.jdbc.user" value="pci"/>
			<property name="jakarta.persistence.jdbc.password" value="pci"/>
			<property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
			<property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/pci?useUnicode=true&amp;useJDBCCompliantTimezoneShift=true&amp;useLegacyDatetimeCode=false&amp;serverTimezone=UTC&amp;useSSL=false&amp;allowPublicKeyRetrieval=true"/>
			<property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
			<property name="eclipselink.ddl-generation.output-mode" value="database"/>
			<property name="eclipselink.logging.level.sql" value="FINE"/>
		</properties>
	</persistence-unit>
</persistence>
